# Copy to .env and adjust. Never commit the real .env.

# Generate one with:  openssl rand -base64 42
SUPERSET_SECRET_KEY=change-me-to-a-long-random-string

SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
SUPERSET_DB_PASSWORD=superset
READER_PASSWORD=reader

# Size of the synthetic portfolio
N_CONTRACTS=12000

# Host ports
SUPERSET_HOST_PORT=8088
POSTGRES_HOST_PORT=5433
